FROM python:3.11-slim

WORKDIR /app

# Copy requirements early for better layer caching
COPY requirements.txt .

# Install system build dependencies + upgrade pip + install with wheel-only mode
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        python3-dev \
        libffi-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        rustc \
        cargo \
        git && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --default-timeout=1000 \
        --retries=20 \
        --use-deprecated=legacy-resolver \
        --only-binary :all:

# Optional: Quick sanity check
RUN python -c "\
    import cryptography; \
    import fastapi; \
    import uvicorn; \
    import torch; \
    print('All key packages imported successfully!')"

# If it reaches here, dependencies installed fine
CMD ["echo", "Requirements test passed!"]