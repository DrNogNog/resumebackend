FROM python:3.11-slim

WORKDIR /app

# Copy only requirements (no need for app code or TinyTeX for this test)
COPY requirements.txt .

# Install dependencies (this is the part you want to test)
RUN pip install --no-cache-dir -r requirements.txt

# Optional: Quick sanity check - start Python and import a few key packages
# (Remove or customize if not needed)
RUN python -c "\
    import cryptography; \
    import fastapi; \
    import uvicorn; \
    import torch; \
    print('All key packages imported successfully!')"

# If it reaches here, dependencies installed fine
CMD ["echo", "Requirements test passed!"]